#pragma once

#define WIFI_SSID     "NOMBRE_DE_SU_RED"
#define WIFI_PASSWORD "CLAVE_DE_SU_RED"

// IP de la PC donde corre Spring Boot (misma red Wi-Fi). Ej.: http://192.168.1.50:8080
// Use la IP de la PC, NO "localhost" (para el ESP32, localhost es el mismo ESP32).
#define SERVER_URL    "http://192.168.1.50:8080"

// Codigo y clave del dispositivo. La clave del ESP32-01 de la demo es el valor
// de la variable de entorno DEVICE_KEY del backend (por defecto en desarrollo:
// dev-device-key-cambiar). Para otros dispositivos use la clave que muestra la web al registrarlos.
#define DEVICE_CODE   "ESP32-01"
#define DEVICE_KEY    "dev-device-key-cambiar"

// Factor de escala de la celda de carga obtenido con calibracion_hx711.ino
#define HX711_CALIBRATION_FACTOR 420.0f
