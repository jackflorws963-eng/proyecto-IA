# SmartStock IoT - variables de entorno (servidor, IntelliJ o Docker). Copie como .env y NO lo suba al repositorio.
# La aplicacion de escritorio no las necesita: su asistente de instalacion guarda la configuracion en
# %USERPROFILE%\.smartstock\application.properties

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/smartstock
# Usuario propio de la aplicacion (ver database/crear_usuario_bd.sql), nunca "postgres"
DB_USER=smartstock
DB_PASSWORD=cambie-esta-clave-de-base-de-datos
# Solo Docker: contrasena del superusuario del contenedor PostgreSQL
POSTGRES_PASSWORD=cambie-esta-clave-del-superusuario

# --- Usuarios y dispositivo inicial ---
ADMIN_PASSWORD=Cambie-Esta-Clave-1
OPERADOR_PASSWORD=Cambie-Esta-Clave-2
DEVICE_KEY=una-clave-larga-y-aleatoria-para-el-esp32

# --- Opciones ---
PORT=8080
IOT_MINUTOS_OFFLINE=2
UMBRAL_DISCREPANCIA_PCT=10
# Lecturas de peso seguidas sobre el umbral para abrir una discrepancia
LECTURAS_CONFIRMACION=3
IGV_PCT=18
# true solo si el sistema se sirve por HTTPS
COOKIE_SECURE=false
# Solo en su PC de desarrollo: permite arrancar con las claves por defecto
# (Admin123!, Operador123!, dev-device-key-cambiar, DB_PASSWORD=postgres).
# Sin esta variable, el backend se niega a arrancar si alguna sigue con ese valor.
# PERMITIR_CLAVES_DEV=true
